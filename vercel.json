{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "env": {
        "VITE_API_URL": "https://vital-online-app.onrender.com/api",
        "VITE_SOCKET_URL": "https://vital-online-app.onrender.com"
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}

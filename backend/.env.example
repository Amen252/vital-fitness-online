# Existing online MongoDB Atlas database (shared by web + mobile via this API).
# Use your cluster URI — do NOT create a new database; keep the `vitalguide` DB name.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/vitalguide?retryWrites=true&w=majority&appName=Cluster0

# Auth
JWT_SECRET=change-me-in-production

# API port (must match frontend VITE_API_URL and mobile ApiConfig)
PORT=5050
CLIENT_URL=http://127.0.0.1:5174
PUBLIC_WEB_URL=http://127.0.0.1:5174
